# Set to the final production URL before publishing (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-real-production-site.vercel.app


# Optional: paste only the https://www.google.com/maps/embed?... SRC from
# Google Maps > Share > Embed a map. The supplied short Maps link always
# works as the fallback even if no embed URL is configured.
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=...
